<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_mf_white_list" model="ir.ui.view">
        <field name="name">account.move.form.hfb.app.mf.white.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_mf_white_list_check"
                        type="object"
                        string="Verify on White List"
                        invisible="move_type not in ('in_invoice', 'in_refund')"
                        groups="account.group_account_invoice"/>
            </xpath>

            <!-- the first partner_bank_id in the form is the vendor bill's "Recipient Bank" -->
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="mf_white_list_result" widget="badge"
                       decoration-success="mf_white_list_result == 'assigned'"
                       decoration-danger="mf_white_list_result == 'not_assigned'"
                       decoration-warning="mf_white_list_result == 'error'"
                       invisible="move_type not in ('in_invoice', 'in_refund') or not mf_white_list_result"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="White List" name="mf_white_list"
                      invisible="move_type not in ('in_invoice', 'in_refund')">
                    <field name="mf_white_list_check_ids" readonly="1"/>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
