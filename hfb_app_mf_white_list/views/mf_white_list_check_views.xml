<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hfb_mf_white_list_check_view_form" model="ir.ui.view">
        <field name="name">hfb.mf.white.list.check.form</field>
        <field name="model">hfb.mf.white.list.check</field>
        <field name="arch" type="xml">
            <form string="White List Check" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="result" widget="badge"
                                   decoration-success="result == 'assigned'"
                                   decoration-danger="result == 'not_assigned'"
                                   decoration-warning="result == 'error'"/>
                            <field name="request_id"/>
                            <field name="message" invisible="not message"/>
                            <field name="move_id"/>
                        </group>
                        <group>
                            <field name="vat"/>
                            <field name="account_number"/>
                            <field name="check_date"/>
                            <field name="create_date" string="Checked On"/>
                            <field name="create_uid" string="Checked By"/>
                        </group>
                    </group>
                    <group string="API Response">
                        <field name="response" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hfb_mf_white_list_check_view_tree" model="ir.ui.view">
        <field name="name">hfb.mf.white.list.check.tree</field>
        <field name="model">hfb.mf.white.list.check</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="create_date" string="Checked On"/>
                <field name="create_uid" string="Checked By" widget="many2one_avatar_user"/>
                <field name="check_date"/>
                <field name="vat"/>
                <field name="account_number"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'assigned'"
                       decoration-danger="result == 'not_assigned'"
                       decoration-warning="result == 'error'"/>
                <field name="request_id"/>
                <field name="message" optional="hide"/>
            </tree>
        </field>
    </record>

</odoo>
